{
  "name": "effect-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "dev-kit apply",
    "sync:effect": "dev-kit effect sync",
    "patch:tsgo": "dev-kit tsgo patch",
    "changeset": "bun x changeset",
    "changeset:version": "bun x changeset version",
    "changeset:publish": "bun x changeset publish",
    "release:publish": "bun scripts/release-publish.ts",
    "release:prepare": "bun scripts/release-publish.ts",
    "verify:changesets-release": "bun scripts/verify-changesets-release.ts",
    "ci:version": "bun x changeset version && bun install",
    "requirements:coverage": "bun scripts/requirements-coverage.ts",
    "reset:development-storage": "bun scripts/reset-development-storage.ts",
    "formal:check": "bun scripts/formal-check.ts",
    "admin:durable": "node --experimental-transform-types scripts/durable-admin.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "vp fmt",
    "format:write": "vp fmt --write",
    "lint": "vp lint",
    "action:build": "bun scripts/build-action.ts",
    "check": "vp check && vp run --concurrency-limit 1 -F './packages/*' check && vp run -F './examples/*' check && tsc --noEmit -p scripts/tsconfig.json && bun scripts/build-action.ts --check",
    "test": "vp run -F './packages/*' test && vp run -F './examples/*' test",
    "build": "vp run -F './packages/*' build && vp run -F './examples/*' build && bun run docs:build",
    "ready": "bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@danieljvdm/dev-kit": "0.17.0",
    "@effect-agent/core": "workspace:*",
    "@effect-agent/platform-node": "workspace:*",
    "@effect-agent/session": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.72",
    "effect": "catalog:",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:"
  },
  "overrides": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@base-ui/react": "1.6.0",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260813.1",
    "@effect/ai-anthropic": "4.0.0-beta.107",
    "@effect/ai-openai": "4.0.0-beta.107",
    "@effect/atom-react": "4.0.0-beta.107",
    "@effect/platform-browser": "4.0.0-beta.107",
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/sql-sqlite-do": "4.0.0-beta.107",
    "@effect/sql-sqlite-node": "4.0.0-beta.107",
    "@effect/tsgo": "0.33.0",
    "@effect/vitest": "4.0.0-beta.107",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.33",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/scheduler": "0.26.0",
    "@types/node": "26.1.2",
    "@vitejs/plugin-react": "6.0.4",
    "ai": "7.0.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.107",
    "effect-cf": "0.25.3",
    "esbuild": "0.28.1",
    "lucide-react": "1.27.0",
    "miniflare": "4.20260730.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scheduler": "0.27.0",
    "shadcn": "4.16.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "4.1.10",
    "vue": "3.5.40"
  }
}
