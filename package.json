{
  "name": "effect-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "bun scripts/patch-effect-tsgo.ts",
    "changeset": "bun x changeset",
    "changeset:version": "bun x changeset version",
    "changeset:publish": "bun x changeset publish",
    "release:publish": "bun scripts/release-publish.ts",
    "release:prepare": "bun scripts/release-publish.ts",
    "verify:changesets-release": "bun scripts/verify-changesets-release.ts",
    "ci:version": "bun x changeset version && bun install",
    "reset:development-storage": "bun scripts/reset-development-storage.ts",
    "formal:check": "bun scripts/formal-check.ts",
    "verify:package-purity": "bun scripts/verify-package-purity.ts",
    "admin:durable": "node --experimental-transform-types scripts/durable-admin.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "vp fmt",
    "format:write": "vp fmt --write",
    "lint": "vp lint",
    "action:build": "bun scripts/build-action.ts",
    "check": "vp check && vp run -r --concurrency-limit 1 check && tsc --noEmit -p scripts/tsconfig.json && bun scripts/verify-package-purity.ts && bun scripts/build-action.ts --check",
    "test": "vp run -r --parallel --concurrency-limit 4 test",
    "build": "vp run -r build && vp run docs:build",
    "ready": "vp run check && vp run test && vp run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@effect-agent/capabilities": "workspace:*",
    "@effect-agent/core": "workspace:*",
    "@effect-agent/engine": "workspace:*",
    "@effect-agent/platform-cloudflare": "workspace:*",
    "@effect-agent/platform-node": "workspace:*",
    "@effect-agent/sandbox": "workspace:*",
    "@effect-agent/sandbox-local": "workspace:*",
    "@effect-agent/session": "workspace:*",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@shikijs/vitepress-twoslash": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.72",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "catalog:",
    "typescript-twoslash": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:"
  },
  "overrides": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@base-ui/react": "1.6.0",
    "@cloudflare/puppeteer": "1.1.0",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260825.1",
    "@effect/ai-anthropic": "4.0.0-rc.111",
    "@effect/ai-openai": "4.0.0-rc.111",
    "@effect/atom-react": "4.0.0-rc.111",
    "@effect/platform-browser": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/sql-d1": "4.0.0-rc.111",
    "@effect/sql-sqlite-do": "4.0.0-rc.111",
    "@effect/sql-sqlite-node": "4.0.0-rc.111",
    "@effect/tsgo": "0.33.0",
    "@effect/vitest": "4.0.0-rc.111",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@shikijs/vitepress-twoslash": "4.4.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.33",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/scheduler": "0.26.0",
    "@types/node": "26.1.2",
    "@vitejs/plugin-react": "6.0.4",
    "ai": "7.0.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "8.0.4",
    "effect": "4.0.0-rc.111",
    "effect-cf": "0.37.0",
    "esbuild": "0.28.1",
    "lucide-react": "1.27.0",
    "miniflare": "5.20260811.1-alpha",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scheduler": "0.27.0",
    "shadcn": "4.16.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript-twoslash": "npm:typescript@6.0.3",
    "use-stick-to-bottom": "1.1.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "wrangler": "4.123.0"
  }
}
