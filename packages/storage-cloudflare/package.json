{
  "name": "@effect-agent/storage-cloudflare",
  "version": "0.1.0-beta.44",
  "description": "Durable Object SQLite storage adapters and the routed port protocol for Effect Agent on Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/effect-agent.git",
    "directory": "packages/storage-cloudflare"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./DoMemoryStore": "./src/DoMemoryStore.ts",
    "./DoScheduleStore": "./src/DoScheduleStore.ts",
    "./DoStorageConfig": "./src/DoStorageConfig.ts",
    "./DoStorageError": "./src/DoStorageError.ts",
    "./DoStorageFailpoint": "./src/DoStorageFailpoint.ts",
    "./DoStorageVersion": "./src/DoStorageVersion.ts",
    "./DoSubmissionLedger": "./src/DoSubmissionLedger.ts",
    "./DoSubscriptionStore": "./src/DoSubscriptionStore.ts",
    "./DoThreadStore": "./src/DoThreadStore.ts",
    "./MemoryProtocol": "./src/MemoryProtocol.ts",
    "./PortProtocol": "./src/PortProtocol.ts",
    "./PortRouting": "./src/PortRouting.ts",
    "./testing/DoStorageFailpointTesting": "./src/DoStorageFailpointTesting.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect-agent/core": "workspace:*",
    "@effect-agent/thread": "workspace:*",
    "@effect/platform-browser": "catalog:",
    "@effect/sql-sqlite-do": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect-agent/testing": "workspace:*",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  }
}
