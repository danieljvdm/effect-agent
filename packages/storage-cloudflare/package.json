{
  "name": "@effect-agent/storage-cloudflare",
  "version": "0.1.0-beta.122",
  "description": "Durable Object SQLite storage adapters and the routed port protocol for Effect Agent on Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/effect-agent.git",
    "directory": "packages/storage-cloudflare"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./do-memory-store": "./src/DoMemoryStore.ts",
    "./do-schedule-store": "./src/DoScheduleStore.ts",
    "./do-storage-config": "./src/DoStorageConfig.ts",
    "./do-storage-error": "./src/DoStorageError.ts",
    "./do-storage-failpoint": "./src/DoStorageFailpoint.ts",
    "./do-storage-version": "./src/DoStorageVersion.ts",
    "./do-submission-ledger": "./src/DoSubmissionLedger.ts",
    "./do-subscription-store": "./src/DoSubscriptionStore.ts",
    "./do-thread-store": "./src/DoThreadStore.ts",
    "./memory-protocol": "./src/MemoryProtocol.ts",
    "./port-protocol": "./src/PortProtocol.ts",
    "./port-routing": "./src/PortRouting.ts",
    "./testing/do-storage-failpoint-testing": "./src/DoStorageFailpointTesting.ts",
    "./do-message-delivery-store": "./src/DoMessageDeliveryStore.ts"
  },
  "publishConfig": {
