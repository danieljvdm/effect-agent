    "@effect-agent/session": "workspace:*",
    "@effect-agent/storage-memory": "workspace:*",
    "@effect-agent/storage-sqlite": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
