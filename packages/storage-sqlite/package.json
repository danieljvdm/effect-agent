{
  "name": "@effect-agent/storage-sqlite",
  "version": "0.1.0-beta.44",
  "description": "Node SQLite persistence adapters for the Effect Agent durable runtime and optional memory lifecycle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/effect-agent.git",
    "directory": "packages/storage-sqlite"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./SqliteActivityStore": "./src/SqliteActivityStore.ts",
    "./SqliteScheduleStore": "./src/SqliteScheduleStore.ts",
    "./SqliteStorageConfig": "./src/SqliteStorageConfig.ts",
    "./SqliteStorageError": "./src/SqliteStorageError.ts",
    "./SqliteStorageFailpoint": "./src/SqliteStorageFailpoint.ts",
    "./SqliteStorageVersion": "./src/SqliteStorageVersion.ts",
    "./SqliteSubmissionLedger": "./src/SqliteSubmissionLedger.ts",
    "./SqliteSubscriptionStore": "./src/SqliteSubscriptionStore.ts",
    "./SqliteThreadStore": "./src/SqliteThreadStore.ts",
    "./testing/SqliteStorageFailpointTesting": "./src/SqliteStorageFailpointTesting.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@effect-agent/core": "workspace:*",
    "@effect-agent/thread": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  }
}
