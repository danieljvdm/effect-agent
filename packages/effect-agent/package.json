    "./EphemeralThreads": "./src/EphemeralThreads.ts",
    "./Identifiers": "./src/Identifiers.ts",
    "./IdGenerator": "./src/IdGenerator.ts",
    "./Mcp": "./src/Mcp.ts",
    "./McpClient": "./src/McpClient.ts",
    "./Memory": "./src/Memory.ts",
