# Email-code authentication remains required; public sign-up removes invitations.
ACCESS_TEAM_DOMAIN=https://orange-cake-d758.cloudflareaccess.com
PUBLIC_SIGN_UP=true

# Stable base64-encoded 32-byte encryption secret. Back it up; do not regenerate on deploy.
BYOK_ENCRYPTION_KEY=

# Only needed for a staged upgrade with PUBLIC_SIGN_UP=false.
ACCESS_GROUP_ID=

# Legacy admitted work retains its model identity. No deployment OPENAI_API_KEY is used.
OPENAI_MODEL=gpt-5.6-luna
