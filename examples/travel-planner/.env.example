# Existing Access group, bootstrapped once; the app owns its email membership.
ACCESS_GROUP_ID=
ACCESS_TEAM_DOMAIN=https://orange-cake-d758.cloudflareaccess.com

# Required account token with only Access: Groups Write in the deployment account.
# Deployment refuses an empty token so invitations cannot silently ship disabled.
ACCESS_API_TOKEN=

# Required for the planner to start.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
