+              runAt: row.run_at,
+              ...(row.repeat_ms === null ? {} : { repeatMs: row.repeat_ms }),
+              payload,
+            },
+          })),
+        ),
+      ),
+    ),
+  );
+
+interface Transaction extends ScheduledEventTransaction {
+  readonly due: (
+    now: number,
+    limit: number,
+  ) => Effect.Effect<ReadonlyArray<PendingEvent>, ScheduledEventError>;
+  readonly matches: (row: StoredEvent) => Effect.Effect<boolean, ScheduledEventError>;
+  readonly acknowledge: (
+    row: StoredEvent,
+    next: number | undefined,
+  ) => Effect.Effect<boolean, ScheduledEventError>;
+}
+
+const rowMatch = "id = ? AND run_at = ? AND repeat_ms IS ? AND payload = ?";
+const rowParams = (row: StoredEvent): cf.SqlStorageValue[] => [
+  row.id,
+  row.run_at,
+  row.repeat_ms,
+  row.payload,
+];
+
+const transaction = <A, E, R>(
+  callback: (tx: Transaction) => Effect.Effect<A, E, R>,
+): Effect.Effect<A, E | ScheduledEventError, R | DurableObjectState> =>
+  Effect.gen(function* () {
+    const storage = (yield* DurableObjectState).raw.storage;
+    const active = yield* Effect.serviceOption(ActiveScheduledTransaction);
+    if (Option.isSome(active) && active.value === storage) {
+      return yield* new ScheduledEventError({
+        reason: "invalid-transaction",
+        operation: "begin",
+        message: "Nested scheduled event transactions are not supported",
+      });
+    }
+    const context = yield* Effect.context<R>();
+    return yield* lockFor(transactionLocks, storage).withPermit(
+      Effect.callback<A, E | ScheduledEventError>((resume, signal) => {
+        let failure: Exit.Failure<A, E | ScheduledEventError> | undefined;
+        const rollback = new Error("Scheduled event transaction rolled back");
+        const pending = Promise.resolve().then(() =>
+          storage.transaction(async (native) => {
+            failure = undefined;
+            let open = true;
+            let owner = -1;
+            const guard = Effect.flatMap(Effect.fiberId, (fiberId) =>
+              open && fiberId === owner
+                ? Effect.void
+                : Effect.fail(
+                    new ScheduledEventError({
+                      reason: "invalid-transaction",
+                      operation: "use",
+                      message:
+                        "A scheduled event transaction may only be used by its active callback fiber",
+                    }),
+                  ),
+            );
+            const exec = (operation: string, query: string, ...params: cf.SqlStorageValue[]) =>
+              guard.pipe(
+                Effect.andThen(
+                  Effect.try({
+                    try: () => storage.sql.exec(query, ...params).rowsWritten,
+                    catch: (cause) => storageError(operation, cause),
+                  }),
+                ),
+              );
+            const read = (query: string, ...params: cf.SqlStorageValue[]) =>
+              guard.pipe(Effect.andThen(readRows(storage, query, ...params)));
+            const tx: Transaction = {
+              upsert: (event) =>
+                guard.pipe(
+                  Effect.andThen(Schema.decodeUnknownEffect(ScheduledEventEntry)(event)),
+                  Effect.mapError((cause) =>
+                    cause instanceof ScheduledEventError ? cause : invalidEvent("upsert", cause),
+                  ),
+                  Effect.flatMap((value) =>
+                    exec(
+                      "upsert",
+                      "INSERT OR REPLACE INTO alchemy_scheduled_events (id, run_at, repeat_ms, payload) VALUES (?, ?, ?, ?)",
+                      value.id,
+                      value.runAt,
+                      value.repeatMs ?? null,
+                      JSON.stringify(value.payload),
+                    ),
+                  ),
+                  Effect.asVoid,
+                ),
+              delete: (id) =>
+                exec("delete", "DELETE FROM alchemy_scheduled_events WHERE id = ?", id).pipe(
+                  Effect.asVoid,
+                ),
+              get: (id) =>
+                read(
+                  "SELECT id, run_at, repeat_ms, payload FROM alchemy_scheduled_events WHERE id = ?",
+                  id,
+                ).pipe(Effect.map((rows) => Option.fromUndefinedOr(rows[0]?.event))),
+              list: () =>
+                read(
+                  "SELECT id, run_at, repeat_ms, payload FROM alchemy_scheduled_events ORDER BY run_at, id",
+                ).pipe(Effect.map((rows) => rows.map(({ event }) => event))),
+              due: (now, limit) =>
+                read(
+                  "SELECT id, run_at, repeat_ms, payload FROM alchemy_scheduled_events WHERE run_at <= ? ORDER BY run_at, id LIMIT ?",
+                  now,
+                  limit,
+                ),
+              matches: (row) =>
+                read(
+                  `SELECT id, run_at, repeat_ms, payload FROM alchemy_scheduled_events WHERE ${rowMatch}`,
+                  ...rowParams(row),
+                ).pipe(Effect.map((rows) => rows.length > 0)),
+              acknowledge: (row, next) =>
+                (next === undefined
+                  ? exec(
+                      "acknowledge",
+                      `DELETE FROM alchemy_scheduled_events WHERE ${rowMatch}`,
+                      ...rowParams(row),
+                    )
+                  : Schema.decodeUnknownEffect(TimeMillis)(next).pipe(
+                      Effect.mapError((cause) => invalidEvent("reschedule", cause)),
+                      Effect.flatMap((runAt) =>
+                        exec(
+                          "reschedule",
+                          `UPDATE alchemy_scheduled_events SET run_at = ? WHERE ${rowMatch}`,
+                          runAt,
+                          ...rowParams(row),
+                        ),
+                      ),
+                    )
+                ).pipe(Effect.map((written) => written > 0)),
+            };
+            const body = Effect.gen(function* () {
+              owner = yield* Effect.fiberId;
+              yield* exec("initialize", INIT_TABLE_SQL);
+              const value = yield* Effect.scoped(Effect.suspend(() => callback(tx)));
+              const next = yield* read(
+                "SELECT id, run_at, repeat_ms, payload FROM alchemy_scheduled_events ORDER BY run_at, id LIMIT 1",
+              );
+              yield* Effect.tryPromise({
+                try: () =>
+                  next.length === 0 ? native.deleteAlarm() : native.setAlarm(next[0]!.row.run_at),
+                catch: (cause) => storageError("alarm", cause),
+              });
+              return value;
+            }).pipe(
+              Effect.provideContext(context),
+              Effect.provideService(ActiveScheduledTransaction, storage),
+              Effect.ensuring(
+                Effect.sync(() => {
+                  open = false;
+                }),
+              ),
+            );
+            const exit = await Effect.runPromiseExit(body, { signal });
+            if (Exit.isFailure(exit)) {
+              failure = exit;
+              throw rollback;
+            }
+            return exit.value;
+          }),
+        );
+        pending.then(
+          (value) => resume(Effect.succeed(value)),
+          (cause) =>
+            resume(
+              failure === undefined
+                ? Effect.fail(storageError("transaction", cause))
+                : Effect.failCause(failure.cause),
+            ),
+        );
+        // Interruption aborts the callback runner through `signal`, then waits
+        // for native rollback before releasing the transaction permit.
+        return Effect.promise(() =>
+          pending.then(
+            () => {},
+            () => {},
+          ),
+        );
+      }),
+    );
+  });
+
+/**
+ * Atomically modify events and other SQL rows in this Durable Object. The native
+ * alarm is reconciled inside the same storage transaction. Typed failures,
+ * defects and interruption roll back; interrupted callers wait for rollback.
+ *
+ * Only the callback fiber may use `tx`; handles cannot escape or be used by
+ * forked effects. Do not perform external side effects in the callback: native
+ * storage transactions may retry it. The legacy event APIs remain unchanged.
+ */
+export const scheduledEventsTransaction = <A, E, R>(
+  callback: (tx: ScheduledEventTransaction) => Effect.Effect<A, E, R>,
+): Effect.Effect<A, E | ScheduledEventError, R | DurableObjectState> => transaction(callback);
+
+export interface HandleScheduledEventsOptions<E, E2 = never, R2 = never, E3 = never, R3 = never> {
+  /** Ordered stops on the first failure; isolated reschedules typed failures. */
+  readonly mode?: "ordered" | "isolated";
+  /** Maximum due events selected per invocation. Default 100; maximum 1000. */
+  readonly limit?: number;
+  /** Delay for isolated failures. Default 1000 milliseconds. */
+  readonly retryMillis?: number;
+  readonly onFailure?: (event: ScheduledEventEntry, error: E) => Effect.Effect<void, E2, R2>;
+  /** Validate the entire bounded snapshot before committing its read or dispatching handlers. */
+  readonly validate?: (event: ScheduledEventEntry) => Effect.Effect<void, E3, R3>;
+}
+
+/**
+ * Handle a bounded snapshot in (runAt, id) order. Acknowledge only after success
+ * and only if the persisted row still matches, preserving handler replacements.
+ * Repeats run again relative to the successful completion time. Defects and
+ * interruption always propagate without acknowledging the event. Isolated mode
+ * reschedules typed failures before invoking `onFailure` and continues; ordered
+ * mode retains the failed row and propagates the handler error.
+ * Validation failures always stop processing without changing rows or alarms.
+ * Calling this operation recursively or from a transaction callback is rejected.
+ *
+ * External effects are at-least-once: a crash after the handler succeeds but
+ * before acknowledgement can deliver it again.
+ */
+export const handleScheduledEvents = <E, R, E2 = never, R2 = never, E3 = never, R3 = never>(
+  handler: (event: ScheduledEventEntry) => Effect.Effect<void, E, R>,
+  options: HandleScheduledEventsOptions<E, E2, R2, E3, R3> = {},
+): Effect.Effect<number, E | E2 | E3 | ScheduledEventError, R | R2 | R3 | DurableObjectState> =>
+  Effect.gen(function* () {
+    const config = yield* Schema.decodeUnknownEffect(
+      Schema.Struct({
+        mode: Schema.Literals(["ordered", "isolated"]),
+        limit: Schema.Int.check(Schema.isGreaterThan(0), Schema.isLessThanOrEqualTo(1000)),
+        retryMillis: Schema.Int.check(Schema.isGreaterThan(0)),
+      }),
+    )({
+      mode: options.mode ?? "ordered",
+      limit: options.limit ?? 100,
+      retryMillis: options.retryMillis ?? 1000,
+    }).pipe(Effect.mapError((cause) => invalidEvent("options", cause)));
+    const storage = (yield* DurableObjectState).raw.storage;
+    const activeTransaction = yield* Effect.serviceOption(ActiveScheduledTransaction);
+    const activeProcessing = yield* Effect.serviceOption(ActiveScheduledProcessing);
+    if (
+      (Option.isSome(activeTransaction) && activeTransaction.value === storage) ||
+      (Option.isSome(activeProcessing) && activeProcessing.value === storage)
+    ) {
+      return yield* new ScheduledEventError({
+        reason: "invalid-transaction",
+        operation: "process",
+        message:
+          "Scheduled event processing cannot be entered from its handler or a transaction callback",
+      });
+    }
+    return yield* lockFor(processingLocks, storage).withPermit(
+      Effect.gen(function* () {
+        const now = yield* Clock.currentTimeMillis;
+        const due = yield* transaction((tx) =>
+          Effect.gen(function* () {
+            const rows = yield* tx.due(now, config.limit);
+            if (options.validate !== undefined) {
+              for (const { event } of rows) yield* options.validate(event);
+            }
+            return rows;
+          }),
+        );
+        let acknowledged = 0;
+        for (const { row, event } of due) {
+          if (!(yield* transaction((tx) => tx.matches(row)))) continue;
+          const result = yield* Effect.result(Effect.suspend(() => handler(event)));
+          if (result._tag === "Failure") {
+            if (config.mode === "isolated") {
+              const retryAt = (yield* Clock.currentTimeMillis) + config.retryMillis;
+              yield* transaction((tx) => tx.acknowledge(row, retryAt));
+            }
+            if (options.onFailure !== undefined) yield* options.onFailure(event, result.failure);
+            if (config.mode === "ordered") return yield* Effect.fail(result.failure);
+            continue;
+          }
+          const completedAt = yield* Clock.currentTimeMillis;
+          if (
+            yield* transaction((tx) =>
+              tx.acknowledge(row, row.repeat_ms === null ? undefined : completedAt + row.repeat_ms),
+            )
+          ) {
+            acknowledged++;
+          }
+        }
+        return acknowledged;
+      }).pipe(Effect.provideService(ActiveScheduledProcessing, storage)),
+    );
+  });
