+import type * as runtime from "@cloudflare/workers-types";
+import * as Effect from "effect/Effect";
+import type { WorkflowHandle, WorkflowInstance, WorkflowInstanceStatus } from "./Workflow.ts";
+import { WorkflowOperationError } from "./WorkflowRuntime.ts";
+
+const operation = <A>(name: string, run: () => Promise<A>) => Effect.tryPromise({
+  try: run,
+  catch: (cause) => new WorkflowOperationError({ operation: name, message: cause instanceof Error ? cause.message : String(cause), cause }),
+});
+
+/** Wrap an existing native Workflow binding, retaining typed failures for instance operations. */
+export const makeWorkflowClient = <Input = unknown, Result = unknown>(
+  binding: Pick<runtime.Workflow<Input>, "create" | "createBatch" | "get">,
+  name = "Workflow",
+): WorkflowHandle<Input, Result> => {
+  const wrap = (raw: runtime.WorkflowInstance): WorkflowInstance<Result> => ({
+    id: raw.id,
+    status: () => operation("status", () => raw.status()).pipe(Effect.map((status) => status as WorkflowInstanceStatus<Result>)),
+    pause: () => operation("pause", () => raw.pause()),
+    resume: () => operation("resume", () => raw.resume()),
+    restart: (options) => operation("restart", () => raw.restart(options)),
+    terminate: () => operation("terminate", () => raw.terminate()),
+    sendEvent: (event) => operation("sendEvent", () => raw.sendEvent({ type: event.type, payload: event.payload })),
+  });
+  return {
+    Type: "Cloudflare.Workflow",
