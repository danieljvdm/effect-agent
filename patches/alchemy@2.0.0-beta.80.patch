+ * Validation failures always stop processing without changing rows or alarms.
+ * Calling this operation recursively or from a transaction callback is rejected.
+ *
+ * External effects are at-least-once: a crash after the handler succeeds but
+ * before acknowledgement can deliver it again.
+ */
+export const handleScheduledEvents = <E, R, E2 = never, R2 = never, E3 = never, R3 = never>(
+  handler: (event: ScheduledEventEntry) => Effect.Effect<void, E, R>,
+  options: HandleScheduledEventsOptions<E, E2, R2, E3, R3> = {},
+): Effect.Effect<number, E | E2 | E3 | ScheduledEventError, R | R2 | R3 | DurableObjectState> =>
+  Effect.gen(function* () {
+    const config = yield* Schema.decodeUnknownEffect(
+      Schema.Struct({
+        mode: Schema.Literals(["ordered", "isolated"]),
+        limit: Schema.Int.check(Schema.isGreaterThan(0), Schema.isLessThanOrEqualTo(1000)),
+        retryMillis: Schema.Int.check(Schema.isGreaterThan(0)),
+      }),
+    )({
+      mode: options.mode ?? "ordered",
+      limit: options.limit ?? 100,
+      retryMillis: options.retryMillis ?? 1000,
+    }).pipe(Effect.mapError((cause) => invalidEvent("options", cause)));
+    const storage = (yield* DurableObjectState).raw.storage;
+    const activeTransaction = yield* Effect.serviceOption(ActiveScheduledTransaction);
+    const activeProcessing = yield* Effect.serviceOption(ActiveScheduledProcessing);
+    const nativeTransactions = yield* ActiveStorageTransactions;
+    if (
+      (Option.isSome(activeTransaction) && activeTransaction.value === storage) ||
+      (Option.isSome(activeProcessing) && activeProcessing.value === storage) ||
+      nativeTransactions.has(storage)
+    ) {
+      return yield* new ScheduledEventError({
+        reason: "invalid-transaction",
+        operation: "process",
+        message:
+          "Scheduled event processing cannot be entered from its handler or a transaction callback",
+      });
+    }
+    return yield* lockFor(processingLocks, storage).withPermit(
+      Effect.gen(function* () {
+        const now = yield* Clock.currentTimeMillis;
+        const due = yield* transaction((tx) =>
+          Effect.gen(function* () {
+            const rows = yield* tx.due(now, config.limit);
+            if (options.validate !== undefined) {
+              for (const { event } of rows) yield* options.validate(event);
+            }
+            return rows;
+          }),
+        );
+        let acknowledged = 0;
+        for (const { row, event } of due) {
+          if (!(yield* transaction((tx) => tx.matches(row)))) continue;
+          const result = yield* Effect.result(Effect.suspend(() => handler(event)));
+          if (result._tag === "Failure") {
+            if (config.mode === "isolated") {
+              const retryAt = (yield* Clock.currentTimeMillis) + config.retryMillis;
+              yield* transaction((tx) => tx.acknowledge(row, retryAt));
+            }
+            if (options.onFailure !== undefined) yield* options.onFailure(event, result.failure);
+            if (config.mode === "ordered") return yield* Effect.fail(result.failure);
+            continue;
+          }
+          const completedAt = yield* Clock.currentTimeMillis;
+          if (
+            yield* transaction((tx) =>
+              tx.acknowledge(row, row.repeat_ms === null ? undefined : completedAt + row.repeat_ms),
+            )
+          ) {
+            acknowledged++;
+          }
+        }
+        return acknowledged;
+      }).pipe(Effect.provideService(ActiveScheduledProcessing, storage)),
+    );
+  });
