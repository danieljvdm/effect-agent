diff --git a/src/Cloudflare/Workflows/WorkflowClient.ts b/src/Cloudflare/Workflows/WorkflowClient.ts
new file mode 100644
index 0000000..1a4429e
--- /dev/null
+++ b/src/Cloudflare/Workflows/WorkflowClient.ts
@@ -0,0 +1,70 @@
+import type * as runtime from "@cloudflare/workers-types";
+import * as Effect from "effect/Effect";
+import * as Stream from "effect/Stream";
+
+import type { WorkflowHandle, WorkflowInstance, WorkflowInstanceStatus } from "./Workflow.ts";
+import { WorkflowOperationError } from "./WorkflowRuntime.ts";
+
+const operationError = (operation: string, cause: unknown) =>
+  new WorkflowOperationError({
+    operation,
+    message: cause instanceof Error ? cause.message : String(cause),
+    cause,
+  });
+
+const operation = <A>(name: string, run: () => Promise<A>) =>
+  Effect.tryPromise({ try: run, catch: (cause) => operationError(name, cause) });
+
+/** Wrap an existing native Workflow binding, retaining typed failures for instance operations. */
+export const makeWorkflowClient = <Input = unknown, Result = unknown>(
+  binding: Pick<runtime.Workflow<Input>, "create" | "createBatch" | "get" | "deleteBatch">,
+  name = "Workflow",
+): WorkflowHandle<Input, Result> => {
+  const wrap = (raw: runtime.WorkflowInstance): WorkflowInstance<Result> => ({
+    id: raw.id,
+    status: () =>
+      operation("status", () => raw.status()).pipe(
+        Effect.map((status) => status as WorkflowInstanceStatus<Result>),
+      ),
+    pause: () => operation("pause", () => raw.pause()),
+    resume: () => operation("resume", () => raw.resume()),
+    restart: (options) => operation("restart", () => raw.restart(options)),
+    terminate: () => operation("terminate", () => raw.terminate()),
+    delete: () => operation("delete", () => raw.delete()),
+    // Match beta.80's subscription ownership: release on completion or interruption.
+    subscribe: (options) =>
+      Stream.unwrap(
+        Effect.acquireRelease(
+          operation(
+            "subscribe",
+            () =>
+              raw.subscribe(options) as Promise<runtime.WorkflowInstanceSubscription & Disposable>,
+          ),
+          (subscription) => Effect.sync(() => subscription[Symbol.dispose]()),
+        ).pipe(
+          Effect.map((subscription) =>
+            Stream.fromAsyncIterable(
+              { [Symbol.asyncIterator]: () => ({ next: () => subscription.next() }) },
+              (cause) => operationError("subscribe", cause),
+            ),
+          ),
+        ),
+      ),
+    sendEvent: (event) =>
+      operation("sendEvent", () => raw.sendEvent({ type: event.type, payload: event.payload })),
+  });
+  return {
+    Type: "Cloudflare.Workflow",
+    name,
+    create: (options) =>
+      operation("create", () =>
+        binding.create(options as runtime.WorkflowInstanceCreateOptions<Input>),
+      ).pipe(Effect.map(wrap)),
+    createBatch: (batch) =>
+      operation("createBatch", () =>
+        binding.createBatch(batch as runtime.WorkflowInstanceCreateOptions<Input>[]),
+      ).pipe(Effect.map((instances) => instances.map(wrap))),
+    get: (id) => operation("get", () => binding.get(id)).pipe(Effect.map(wrap)),
+    deleteBatch: (ids) => operation("deleteBatch", () => binding.deleteBatch(ids)),
+  };
+};
