+import * as Effect from "effect/Effect";
+import * as Stream from "effect/Stream";
+import { WorkflowOperationError } from "./WorkflowRuntime.js";
+const operationError = (operation, cause) => new WorkflowOperationError({
+    operation,
+    message: cause instanceof Error ? cause.message : String(cause),
+    cause,
+});
+const operation = (name, run) => Effect.tryPromise({ try: run, catch: (cause) => operationError(name, cause) });
+/** Wrap an existing native Workflow binding, retaining typed failures for instance operations. */
+export const makeWorkflowClient = (binding, name = "Workflow") => {
+    const wrap = (raw) => ({
+        id: raw.id,
+        status: () => operation("status", () => raw.status()).pipe(Effect.map((status) => status)),
+        pause: () => operation("pause", () => raw.pause()),
+        resume: () => operation("resume", () => raw.resume()),
+        restart: (options) => operation("restart", () => raw.restart(options)),
+        terminate: () => operation("terminate", () => raw.terminate()),
+        delete: () => operation("delete", () => raw.delete()),
+        // Match beta.80's subscription ownership: release on completion or interruption.
+        subscribe: (options) => Stream.unwrap(Effect.acquireRelease(operation("subscribe", () => raw.subscribe(options)), (subscription) => Effect.sync(() => subscription[Symbol.dispose]())).pipe(Effect.map((subscription) => Stream.fromAsyncIterable({ [Symbol.asyncIterator]: () => ({ next: () => subscription.next() }) }, (cause) => operationError("subscribe", cause))))),
+        sendEvent: (event) => operation("sendEvent", () => raw.sendEvent({ type: event.type, payload: event.payload })),
+    });
+    return {
+        Type: "Cloudflare.Workflow",
+        name,
+        create: (options) => operation("create", () => binding.create(options)).pipe(Effect.map(wrap)),
+        createBatch: (batch) => operation("createBatch", () => binding.createBatch(batch)).pipe(Effect.map((instances) => instances.map(wrap))),
+        get: (id) => operation("get", () => binding.get(id)).pipe(Effect.map(wrap)),
+        deleteBatch: (ids) => operation("deleteBatch", () => binding.deleteBatch(ids)),
+    };
+};
+//# sourceMappingURL=WorkflowClient.js.map
