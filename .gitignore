node_modules
dist
# The bundled GitHub Action is committed by design (pr-review ADR): a
# node-runtime action must run straight from a checkout. `bun run check`
# verifies it stays in sync with the source.
!action/dist/
.worktrees
coverage
.vite
docs/.vitepress/cache
docs/.vitepress/dist
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
# wrangler local secrets (never commit): keep only the *.example templates
.dev.vars
.dev.vars.*
!.dev.vars.example
# wrangler local dev cache
.wrangler
.dev-kit
.repos
# alchemy local state (ALCHEMY_LOCAL_STATE=true dry runs)
.alchemy
# Generated declarations that leak into package src when a build follows a
# cross-package relative source import (e.g. the C4 conformance worker). No
# .d.ts under src is hand-written; source is always .ts.
packages/*/src/**/*.d.ts
